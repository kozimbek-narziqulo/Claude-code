#Requires AutoHotkey v2.0
#SingleInstance Force

; ============================================================
;  ВСЁ В ОДНОМ (исправленная версия)
; ------------------------------------------------------------
;  1) Ñ / ñ при удержании клавиши N (англ. и испанская раскладки)
;  2) F9 — пауза / воспроизведение музыки
;  3) Переключение раскладки одиночным нажатием LAlt
;
;  ГЛАВНОЕ ИСПРАВЛЕНИЕ: Alt больше НЕ блокируется и НЕ подделывается.
;  Он доходит до приложений как обычно, поэтому работают все
;  стандартные сочетания (Alt+Tab, Alt+F4, Alt+←/→ в Chrome, Alt+D...).
; ============================================================


; ============================================================
;  1) Ñ ПРИ УДЕРЖАНИИ N
; ============================================================

; Проверка активной английской или испанской раскладки
IsEnglishOrSpanish() {
    threadID := DllCall("GetWindowThreadProcessId", "Ptr", WinExist("A"), "Ptr", 0)
    layout := DllCall("GetKeyboardLayout", "UInt", threadID, "Ptr")
    langID := layout & 0xFFFF
    return (langID == 0x0409 || langID == 0x0C0A || langID == 0x040A)
}

; Не вмешиваемся, если зажат Ctrl / Alt / Win — чтобы работали
; Ctrl+N, Ctrl+Shift+N, Alt+N, Win+N и другие системные сочетания.
NoSystemModifiers() {
    return !(GetKeyState("Ctrl", "P") || GetKeyState("Alt", "P")
          || GetKeyState("LWin", "P") || GetKeyState("RWin", "P"))
}

; Условие действует только на хоткей ниже, дальше оно сбрасывается
#HotIf IsEnglishOrSpanish() && NoSystemModifiers()

; Работает с Shift и Caps Lock
*$n:: {
    ; Определяем, должна ли буква быть заглавной (зажат Shift ИЛИ включен CapsLock, но не оба сразу)
    isShift := GetKeyState("Shift", "P")
    isCaps := GetKeyState("CapsLock", "T")
    isUpper := (isShift && !isCaps) || (!isShift && isCaps)

    ; Мгновенно отправляем N (маленькую или заглавную) — никакой задержки при отклике!
    Send(isUpper ? "N" : "n")

    ; Ждем 0.25 секунды. Если клавишу отпустили быстро — ничего дальше не делаем
    if KeyWait("n", "T0.25") {
        return
    }

    ; Если клавишу продолжают удерживать — стираем напечатанную N и меняем на Ñ
    Send("{Backspace}")
    Send(isUpper ? "Ñ" : "ñ")

    ; Ждем окончательного отпускания клавиши, чтобы буква не дублировалась
    KeyWait("n")
}

; Сброс условия: всё, что ниже, работает всегда и во всех раскладках
#HotIf


; ============================================================
;  2) МУЗЫКА: F9 = пауза / воспроизведение
; ============================================================
F9::Media_Play_Pause


; ============================================================
;  3) ПЕРЕКЛЮЧЕНИЕ РАСКЛАДКИ ПО ОДИНОЧНОМУ LAlt
; ------------------------------------------------------------
;  Как это работает:
;  - "~" перед LAlt означает: нажатие Alt проходит в систему как
;    обычно (ничего не блокируем и не подделываем).
;  - Сразу после нажатия Alt отправляем "пустую" клавишу vkE8
;    (не назначена ни на что). Для Windows, Chrome и Electron-
;    приложений это значит "Alt был не один", поэтому скрытое
;    меню (Файл / Правка / Вид...) и подсказки Проводника при
;    одиночном Alt не открываются.
;  - При отпускании Alt проверяем, была ли последней нажатой
;    клавишей именно LAlt. Если да — это одиночный тап, и мы
;    переключаем раскладку (Win+Space). Если между нажатием и
;    отпусканием была другая клавиша (Tab, F4, стрелки...) —
;    это обычное сочетание, раскладка не трогается.
; ============================================================

~LAlt::Send("{Blind}{vkE8}")

~LAlt Up:: {
    if (A_PriorKey = "LAlt") {
        Send("#{Space}")     ; Win+Space
        ; Если в системе переключение по Alt+Shift, замените на:
        ; Send("{Alt down}{Shift down}{Shift up}{Alt up}")
    }
}
